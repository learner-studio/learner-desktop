#!/usr/bin/env bash
# Every commit: the secret scan and the light lane, run against exactly what is being
# committed (unstaged changes and untracked files are set aside while the lane runs).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); refusing to commit unscanned" >&2
  exit 1
fi
gitleaks git --staged . --redact --no-banner >/dev/null 2>&1 || {
  echo "pre-commit: gitleaks found a possible secret in the staged changes:" >&2
  gitleaks git --staged . --redact --no-banner >&2 || true
  exit 1
}

# The stash list is shared by every worktree of this repo, so the stash is found by its
# own unique message, never popped blindly as stash@{0}.
tag="pre-commit $$ $(date +%s) $(git rev-parse --show-toplevel)"
stashed=0
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  git stash push --keep-index --include-untracked --quiet --message "$tag" && stashed=1
fi
restore() {
  [ "$stashed" = 1 ] || return 0
  local ref
  ref="$(git stash list --format='%gd %gs' | grep -F -- "$tag" | head -1 | cut -d' ' -f1)"
  if [ -n "$ref" ]; then
    git stash pop --quiet "$ref" || echo "pre-commit: could not restore unstaged changes; they are in $ref" >&2
  else
    echo "pre-commit: the stash '$tag' is missing; check 'git stash list'" >&2
  fi
}
trap restore EXIT

scripts/test.sh light
