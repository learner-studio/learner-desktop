#!/usr/bin/env bash
# Every commit: the secret scan. No tests run on this Mac: all testing is CI's, on a GitHub
# macOS runner, for every pull request into main (.github/workflows/ci.yml). The repo is
# public, so the scan stays here: a pushed secret cannot be taken back.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); refusing to commit unscanned" >&2
  exit 1
fi
gitleaks git --staged . --redact --no-banner >/dev/null 2>&1 || {
  echo "pre-commit: gitleaks found a possible secret in the staged changes:" >&2
  gitleaks git --staged . --redact --no-banner >&2 || true
  exit 1
}
